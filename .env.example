# Application
APP_NAME="VaultMesh"
APP_ENV="development"
API_V1_PREFIX="/api/v1"
SECRET_KEY="change-me-to-a-strong-random-hex-string-in-production"

# Database (SQLite for ₹0 local dev; PostgreSQL for production)
DATABASE_URL="sqlite:///./vaultmesh.db"

# CORS (Frontend URL)
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# AWS Integration Mode ("mock" for ₹0 offline dev, "live" for real AWS STS)
AWS_INTEGRATION_MODE="mock"
AWS_DEFAULT_REGION="ap-south-1"
