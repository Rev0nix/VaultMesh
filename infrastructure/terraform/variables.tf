variable "aws_region" {
  description = "Primary AWS region for VaultMesh security resources"
  type        = string
  default     = "ap-south-1"
}

variable "trusted_principal_arn" {
  description = "ARN of the IAM user/role permitted to assume the VaultMesh audit role"
  type        = string
}

variable "external_id" {
  description = "Unique ExternalId generated by VaultMesh to prevent confused deputy attacks"
  type        = string
  sensitive   = true
}

variable "enable_cloudtrail_bucket" {
  description = "Create an encrypted S3 bucket for CloudTrail logs (disabled by default to keep cost ₹0)"
  type        = bool
  default     = false
}

variable "enable_cloudtrail" {
  description = "Provision a multi-region CloudTrail trail (disabled by default; additional trails incur AWS charges)"
  type        = bool
  default     = false
}
